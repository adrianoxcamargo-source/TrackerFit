-- ===================== TrackerFit schema =====================
-- profiles: created automatically on signup via trigger
create table if not exists public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  email text not null,
  full_name text not null default '',
  role text not null default 'atleta' check (role in ('atleta','treinador')),
  created_at timestamptz not null default now()
);

-- handle_new_user: populate profiles with the role chosen at signup
create or replace function public.handle_new_user()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  insert into public.profiles (id, email, full_name, role)
  values (
    new.id,
    coalesce(new.email, ''),
    coalesce(new.raw_user_meta_data->>'full_name', ''),
    coalesce(new.raw_user_meta_data->>'role', 'atleta')
  )
  on conflict (id) do update set
    email = excluded.email,
    full_name = excluded.full_name,
    role = excluded.role;
  return new;
end;
$$;

drop trigger if exists on_auth_user_created on auth.users;
create trigger on_auth_user_created
  after insert on auth.users
  for each row execute function public.handle_new_user();

-- athlete_trainer_links: shared access between athlete and trainer
create table if not exists public.athlete_trainer_links (
  id uuid primary key default gen_random_uuid(),
  athlete_id uuid not null references public.profiles(id) on delete cascade,
  trainer_id uuid references public.profiles(id) on delete set null,
  invite_email text not null,
  status text not null default 'pendente' check (status in ('pendente','aceito')),
  created_at timestamptz not null default now(),
  unique (athlete_id, invite_email)
);
create index if not exists idx_atl_invite_email on public.athlete_trainer_links (invite_email);
create index if not exists idx_atl_trainer on public.athlete_trainer_links (trainer_id);

-- Security-definer helpers (bypass RLS, no recursion)
create or replace function public.my_email()
returns text
language sql
security definer
set search_path = public
as $$
  select email from public.profiles where id = auth.uid();
$$;

create or replace function public.can_access_athlete(target uuid)
returns boolean
language sql
security definer
set search_path = public
as $$
  select
    target = auth.uid()
    or exists (
      select 1 from public.athlete_trainer_links l
      where l.trainer_id = auth.uid()
        and l.athlete_id = target
        and l.status = 'aceito'
    );
$$;

-- profiles RLS
alter table public.profiles enable row level security;
drop policy if exists profiles_select on public.profiles;
create policy profiles_select on public.profiles for select using (
  id = auth.uid()
  or exists (
    select 1 from public.athlete_trainer_links l
    where l.status = 'aceito'
      and (
        (l.athlete_id = auth.uid() and l.trainer_id = profiles.id)
        or (l.trainer_id = auth.uid() and l.athlete_id = profiles.id)
      )
  )
);
drop policy if exists profiles_update on public.profiles;
create policy profiles_update on public.profiles for update using (id = auth.uid()) with check (id = auth.uid());

-- athlete_trainer_links RLS
alter table public.athlete_trainer_links enable row level security;
drop policy if exists atl_select on public.athlete_trainer_links;
create policy atl_select on public.athlete_trainer_links for select using (
  athlete_id = auth.uid()
  or trainer_id = auth.uid()
  or invite_email = public.my_email()
);
drop policy if exists atl_insert on public.athlete_trainer_links;
create policy atl_insert on public.athlete_trainer_links for insert with check (athlete_id = auth.uid());
drop policy if exists atl_update on public.athlete_trainer_links;
create policy atl_update on public.athlete_trainer_links for update using (
  athlete_id = auth.uid()
  or invite_email = public.my_email()
  or trainer_id = auth.uid()
) with check (
  athlete_id = auth.uid()
  or invite_email = public.my_email()
  or trainer_id = auth.uid()
);
drop policy if exists atl_delete on public.athlete_trainer_links;
create policy atl_delete on public.athlete_trainer_links for delete using (athlete_id = auth.uid());

-- ===================== athlete-owned tables =====================
create table if not exists public.program_settings (
  athlete_id uuid primary key references public.profiles(id) on delete cascade,
  start_date date not null default current_date,
  duration_days int not null default 60,
  current_weight_kg numeric not null default 82.9,
  current_bodyfat_pct numeric not null default 18.3,
  goal_weight_kg numeric not null default 80,
  goal_bodyfat_pct numeric not null default 10,
  session_max_minutes int not null default 50,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists public.exercises (
  id uuid primary key default gen_random_uuid(),
  athlete_id uuid not null references public.profiles(id) on delete cascade,
  name text not null,
  category text not null,
  progression_default text not null default 'Carga',
  knee_alert boolean not null default false,
  sort_order int not null default 0,
  created_at timestamptz not null default now()
);

create table if not exists public.workouts (
  id uuid primary key default gen_random_uuid(),
  athlete_id uuid not null references public.profiles(id) on delete cascade,
  name text not null,
  weekday_label text not null,
  sort_order int not null default 0,
  created_at timestamptz not null default now()
);

create table if not exists public.workout_exercises (
  id uuid primary key default gen_random_uuid(),
  athlete_id uuid not null references public.profiles(id) on delete cascade,
  workout_id uuid not null references public.workouts(id) on delete cascade,
  exercise_id uuid not null references public.exercises(id) on delete cascade,
  sort_order int not null default 0,
  sets_planned int not null default 3,
  reps_target text not null default '',
  rir_target int not null default 3,
  notes text,
  created_at timestamptz not null default now()
);

create table if not exists public.workout_logs (
  id uuid primary key default gen_random_uuid(),
  athlete_id uuid not null references public.profiles(id) on delete cascade,
  workout_id uuid not null references public.workouts(id) on delete restrict,
  performed_at date not null default current_date,
  logged_by uuid references public.profiles(id) on delete set null,
  notes text,
  created_at timestamptz not null default now()
);

create table if not exists public.set_logs (
  id uuid primary key default gen_random_uuid(),
  athlete_id uuid not null references public.profiles(id) on delete cascade,
  workout_log_id uuid not null references public.workout_logs(id) on delete cascade,
  exercise_id uuid not null references public.exercises(id) on delete restrict,
  set_number int not null,
  load_kg numeric not null default 0,
  reps_done int not null default 0,
  difficulty int not null default 3 check (difficulty between 1 and 5),
  notes text,
  created_at timestamptz not null default now()
);

create table if not exists public.body_metrics (
  id uuid primary key default gen_random_uuid(),
  athlete_id uuid not null references public.profiles(id) on delete cascade,
  recorded_at date not null default current_date,
  weight_kg numeric not null,
  bodyfat_pct numeric,
  created_at timestamptz not null default now()
);

create table if not exists public.cardio_logs (
  id uuid primary key default gen_random_uuid(),
  athlete_id uuid not null references public.profiles(id) on delete cascade,
  performed_at date not null default current_date,
  duration_min int not null,
  notes text,
  created_at timestamptz not null default now()
);

-- RLS + can_access_athlete policies for all athlete-owned tables
do $$
declare
  t text;
  tables text[] := array[
    'program_settings','exercises','workouts','workout_exercises',
    'workout_logs','set_logs','body_metrics','cardio_logs'
  ];
begin
  foreach t in array tables loop
    execute format('alter table public.%I enable row level security', t);

    execute format('drop policy if exists %I on public.%I', t || '_select', t);
    execute format('create policy %I on public.%I for select using (public.can_access_athlete(athlete_id))', t || '_select', t);

    execute format('drop policy if exists %I on public.%I', t || '_insert', t);
    execute format('create policy %I on public.%I for insert with check (public.can_access_athlete(athlete_id))', t || '_insert', t);

    execute format('drop policy if exists %I on public.%I', t || '_update', t);
    execute format('create policy %I on public.%I for update using (public.can_access_athlete(athlete_id)) with check (public.can_access_athlete(athlete_id))', t || '_update', t);

    execute format('drop policy if exists %I on public.%I', t || '_delete', t);
    execute format('create policy %I on public.%I for delete using (public.can_access_athlete(athlete_id))', t || '_delete', t);
  end loop;
end $$;