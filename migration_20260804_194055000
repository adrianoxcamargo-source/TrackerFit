drop policy if exists profiles_select on public.profiles;
create policy profiles_select on public.profiles for select using (
  id = auth.uid()
  or exists (
    select 1 from public.athlete_trainer_links l
    where l.status in ('aceito','pendente')
      and (
        (l.athlete_id = auth.uid() and l.trainer_id = profiles.id)
        or (l.trainer_id = auth.uid() and l.athlete_id = profiles.id)
      )
  )
);